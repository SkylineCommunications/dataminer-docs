{
  "schemaVersion": 1,
  "format": "d4-4-documentation-safety-rules",
  "repository": "SkylineCommunications/dataminer-docs",
  "authoritySources": [
    {
      "id": "d0-metadata-contract",
      "path": "contributing/CTB_Documentation_Metadata.md",
      "role": "Controlled metadata, authority, lifecycle, and compatibility values."
    },
    {
      "id": "d0-corpus-policy",
      "path": "contributing/CTB_Documentation_Corpus_Policy.md",
      "role": "Public artifact boundaries and internal-only transformed output policy."
    },
    {
      "id": "d0-house-style",
      "path": "contributing/CTB_Docs_house_style.md",
      "role": "Canonical terminology and capitalization."
    },
    {
      "id": "d1-connector-repairs",
      "path": "develop/devguide/Connector",
      "role": "D1.1 repaired Connector guidance and API examples."
    },
    {
      "id": "d1-automation-repairs",
      "path": "develop/devguide/Automation",
      "role": "D1.2 and D1.3 repaired Automation guidance and API examples."
    },
    {
      "id": "d4-1-quality-gate",
      "path": "scripts/validate-documentation-quality.ps1",
      "role": "D4.1 changed-file and legacy-finding comparison pattern."
    },
    {
      "id": "d4-2-csharp-harness",
      "path": "contributing/metadata/csharp-documentation-example-v1.schema.json",
      "role": "D4.2 example classification and generated-report boundary."
    },
    {
      "id": "d4-3-xml-harness",
      "path": "contributing/metadata/xml-documentation-examples-v1.schema.json",
      "role": "D4.3 XML example classification and expected-failure boundary."
    }
  ],
  "classification": {
    "marker": "documentation-safety",
    "contexts": [
      "instruction",
      "illustrative",
      "fragment",
      "pseudocode",
      "executable",
      "user-supplied",
      "legacy",
      "conditional",
      "negative-example",
      "ui-label",
      "unclassified"
    ],
    "defaultProse": "instruction",
    "defaultCode": "unclassified",
    "frontMatterMappings": [
      {
        "field": "content_type",
        "value": "example",
        "context": "illustrative"
      },
      {
        "field": "content_type",
        "value": "legacy",
        "context": "legacy"
      },
      {
        "field": "authority",
        "value": "historical",
        "context": "legacy"
      },
      {
        "field": "authority",
        "value": "illustrative",
        "context": "illustrative"
      }
    ]
  },
  "allowlists": [
    {
      "id": "legacy-inline-engine-wrapper",
      "ruleIds": [
        "obsolete-engine-signature",
        "engine-entrypoint-conflict"
      ],
      "pathGlobs": [
        "develop/devguide/Automation/**",
        "dataminer/Functions/Automation_module/**",
        "**"
      ],
      "contexts": [
        "legacy",
        "conditional"
      ],
      "linePatterns": [
        "(?i)legacy\\s+inline",
        "(?i)prior\\s+to",
        "(?i)older\\s+versions?",
        "(?i)context\\s*=\\s*legacy",
        "(?i)context\\s*=\\s*conditional"
      ]
    },
    {
      "id": "conditional-legacy-interactive-api",
      "ruleIds": [
        "obsolete-interactive-run",
        "interactive-dialog-conflict",
        "stale-dev-automation-minimum"
      ],
      "pathGlobs": [
        "develop/devguide/Automation/**",
        "dataminer/Functions/Automation_module/**",
        "develop/TOOLS/**",
        "**"
      ],
      "contexts": [
        "legacy",
        "conditional"
      ],
      "linePatterns": [
        "(?i)up\\s+to\\s+9\\.0\\.1",
        "(?i)prior\\s+to",
        "(?i)older\\s+versions?",
        "(?i)obsolete",
        "(?i)compatibility",
        "(?i)context\\s*=\\s*legacy",
        "(?i)context\\s*=\\s*conditional"
      ]
    },
    {
      "id": "documented-ui-or-code-terminology",
      "ruleIds": [
        "dropdown-noun",
        "popup-noun",
        "corner-direction",
        "dataminer-agent-casing",
        "dataminer-system-casing",
        "dataminer-failover-casing"
      ],
      "pathGlobs": [
        "**"
      ],
      "contexts": [
        "fragment",
        "pseudocode",
        "executable",
        "user-supplied",
        "ui-label"
      ]
    }
  ],
  "negativeExamples": [
    {
      "id": "negative-certificate-validation",
      "ruleIds": [
        "certificate-validation-bypass",
        "tls-verification-disabled"
      ],
      "marker": "documentation-safety: context=negative-example; rule=certificate-validation-bypass"
    },
    {
      "id": "negative-secret-logging",
      "ruleIds": [
        "unsafe-exception-logging",
        "secret-logging"
      ],
      "marker": "documentation-safety: context=negative-example; rule=unsafe-exception-logging"
    },
    {
      "id": "negative-insecure-credential",
      "ruleIds": [
        "insecure-sample-credential",
        "credential-assignment"
      ],
      "marker": "documentation-safety: context=negative-example; rule=insecure-sample-credential"
    }
  ],
  "rules": {
    "prohibitedStrings": [
      {
        "id": "obsolete-engine-signature",
        "severity": "high",
        "pattern": "(?i)\\bRun\\s*\\(\\s*Engine\\s+engine\\b",
        "message": "Use IEngine for current project-based Automation entry points. Retain Engine only in an explicitly marked legacy inline wrapper.",
        "source": "d1-automation-repairs"
      },
      {
        "id": "obsolete-generate-information",
        "severity": "high",
        "pattern": "(?i)\\b(?:engine\\.)?GenerateInformation\\s*\\(",
        "message": "Use the current Automation logging API documented by the D1 repair instead of GenerateInformation.",
        "source": "d1-automation-repairs"
      },
      {
        "id": "obsolete-interactive-run",
        "severity": "high",
        "pattern": "(?i)\\b(?:InteractiveController|controller)\\.Run\\s*\\(",
        "message": "ShowDialog is the preferred current initial-dialog method. Mention Run only with an explicit legacy or version condition.",
        "source": "d1-automation-repairs"
      },
      {
        "id": "stale-dev-automation-minimum",
        "severity": "high",
        "pattern": "(?i)(?:at\\s+least\\s+version\\s+9\\.0\\.2|Skyline\\.DataMiner\\.Dev\\.Automation[^\\r\\n`]{0,100}/10\\.4\\.7)",
        "message": "Do not present the old Dev.Automation version as a universal minimum. State the target-system compatibility condition instead.",
        "source": "d1-automation-repairs"
      }
    ],
    "normativeConflicts": [
      {
        "id": "engine-entrypoint-conflict",
        "severity": "high",
        "claims": [
          {
            "id": "obsolete-engine",
            "pattern": "(?i)\\bRun\\s*\\(\\s*Engine\\s+engine\\b"
          },
          {
            "id": "current-iengine",
            "pattern": "(?i)\\bRun\\s*\\(\\s*IEngine\\s+engine\\b"
          }
        ],
        "message": "The page presents Engine and IEngine entry points without an explicit legacy or version condition.",
        "source": "d1-automation-repairs"
      },
      {
        "id": "interactive-dialog-conflict",
        "severity": "high",
        "claims": [
          {
            "id": "legacy-run",
            "pattern": "(?i)\\b(?:InteractiveController|controller)\\.Run\\s*\\("
          },
          {
            "id": "current-show-dialog",
            "pattern": "(?i)\\b(?:InteractiveController|controller)\\.ShowDialog\\s*\\("
          }
        ],
        "message": "Run and ShowDialog are presented as competing current methods without an explicit legacy or version condition.",
        "source": "d1-automation-repairs"
      }
    ],
    "terminology": [
      {
        "id": "dropdown-noun",
        "severity": "medium",
        "pattern": "(?i)\\bdropdown\\b(?!\\s+(?:menu|list)\\b)",
        "message": "Use dropdown menu or dropdown list instead of dropdown as a noun.",
        "source": "d0-house-style"
      },
      {
        "id": "popup-noun",
        "severity": "medium",
        "pattern": "(?i)\\bpop[- ]?up\\b(?!\\s+(?:window|dialog)\\b)",
        "message": "Use pop-up window or dialog instead of popup as a noun.",
        "source": "d0-house-style"
      },
      {
        "id": "corner-direction",
        "severity": "medium",
        "pattern": "(?i)\\b(?:top|bottom)[ -](?:left|right)\\b",
        "message": "Use upper-left, upper-right, lower-left, or lower-right for corners.",
        "source": "d0-house-style"
      },
      {
        "id": "dataminer-agent-casing",
        "severity": "medium",
        "pattern": "(?i)\\bDataMiner\\s+agent\\b",
        "message": "Capitalize Agent when referring to a DataMiner Agent.",
        "source": "d0-house-style"
      },
      {
        "id": "dataminer-system-casing",
        "severity": "medium",
        "pattern": "(?i)\\bDataMiner\\s+system\\b",
        "message": "Capitalize System when referring to a DataMiner System.",
        "source": "d0-house-style"
      },
      {
        "id": "dataminer-failover-casing",
        "severity": "medium",
        "pattern": "(?i)\\bDataMiner\\s+failover\\b",
        "message": "Capitalize Failover when referring to the DataMiner Failover feature.",
        "source": "d0-house-style"
      }
    ],
    "secrets": [
      {
        "id": "github-token",
        "severity": "critical",
        "pattern": "(?i)\\b(?:ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9]{20,}\\b",
        "message": "Remove the credential-shaped token from documentation or generated output.",
        "redact": true,
        "source": "d0-corpus-policy"
      },
      {
        "id": "generic-api-token",
        "severity": "critical",
        "pattern": "(?i)\\b(?:sk|pk|xoxb|xoxp|xoxa|xoxr)-[A-Za-z0-9_-]{20,}\\b",
        "message": "Remove the credential-shaped token from documentation or generated output.",
        "redact": true,
        "source": "d0-corpus-policy"
      },
      {
        "id": "jwt-token",
        "severity": "high",
        "pattern": "\\beyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}\\b",
        "message": "Do not include a bearer token or JWT in documentation or generated output.",
        "redact": true,
        "source": "d0-corpus-policy"
      },
      {
        "id": "private-key",
        "severity": "critical",
        "pattern": "-----BEGIN(?: [A-Z]+)? PRIVATE KEY-----",
        "message": "Do not include private-key material in documentation or generated output.",
        "redact": true,
        "source": "d0-corpus-policy"
      },
      {
        "id": "credential-assignment",
        "severity": "high",
        "pattern": "(?i)[\"']?(?:api[_ -]?key|access[_ -]?token|client[_ -]?secret|password|passwd|secret|connection[_ -]?string)[\"']?\\s*[:=]\\s*(?:\"(?<credential>[^\"]{6,})\"|'(?<credential>[^']{6,})'|(?<credential><[^>]+>|\\[[^\\]]+\\]|\\$\\{[^}]+\\}|[A-Za-z0-9_+/=.\\-]{12,}))",
        "placeholderPatterns": [
          "(?i)^<[^>]+>$",
          "(?i)^\\[[^\\]]+\\]$",
          "(?i)^\\$\\{[^}]+\\}$",
          "(?i)^(?:your|replace[-_ ]?me|example|sample)[-_ ]?(?:token|key|secret|password)?$",
          "(?i)^(?:token|secret|password)[-_ ]?(?:value)?$"
        ],
        "message": "Use a named placeholder or environment variable instead of a credential-shaped value.",
        "redact": true,
        "source": "d0-corpus-policy"
      },
      {
        "id": "insecure-sample-credential",
        "severity": "high",
        "pattern": "(?i)[\"']?(?:password|passwd)[\"']?\\s*[:=]\\s*['\"]?(?:admin|password|secret|changeme|123456|p@ssw0rd)['\"]?",
        "message": "Do not teach readers to use an insecure sample credential. Use a placeholder and require replacement.",
        "redact": true,
        "source": "d0-corpus-policy"
      }
    ],
    "unsafeDefaults": [
      {
        "id": "certificate-validation-bypass",
        "severity": "critical",
        "pattern": "(?i)(?:ServerCertificateCustomValidationCallback|RemoteCertificateValidationCallback|DangerousAcceptAnyServerCertificateValidator|ServicePointManager\\.ServerCertificateValidationCallback)[^\\r\\n]{0,160}(?:=>\\s*true|return\\s+true|=\\s*true)",
        "message": "Do not disable certificate validation or accept every server certificate as a default.",
        "source": "d0-corpus-policy"
      },
      {
        "id": "tls-verification-disabled",
        "severity": "critical",
        "pattern": "(?i)\\b(?:verify|verify_ssl|validate_certificate|check_certificate|ssl_verify)\\s*[:=]\\s*(?:false|0)\\b",
        "message": "Do not disable TLS or certificate verification as a default.",
        "source": "d0-corpus-policy"
      },
      {
        "id": "unsafe-exception-logging",
        "severity": "high",
        "pattern": "(?i)\\b(?:ExitFail|GenerateInformation|Console\\.WriteLine)\\s*\\([^\\)\\r\\n]*(?:\\b(?:ex|exception|error|e)\\.(?:Message|ToString)|\\+\\s*(?:ex|exception|error|e)\\b)[^\\)\\r\\n]*\\)",
        "message": "Do not expose raw exception details through operator-facing or failure messages. Log diagnostic details separately and return a safe message.",
        "source": "d1-automation-repairs"
      },
      {
        "id": "secret-logging",
        "severity": "critical",
        "pattern": "(?i)\\b(?:Log|WriteLine|GenerateInformation|ExitFail)\\s*\\([^\\)\\r\\n]*(?:password|passwd|secret|token|api[_ -]?key|connection[_ -]?string)\\s*(?:\\+|=|,|\\))[^\\)\\r\\n]*\\)",
        "message": "Do not write credentials, tokens, or secret-bearing values to logs or failure messages.",
        "source": "d0-corpus-policy"
      }
    ]
  }
}
