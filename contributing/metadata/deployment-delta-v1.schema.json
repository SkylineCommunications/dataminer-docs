{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/SkylineCommunications/dataminer-docs/main/contributing/metadata/deployment-delta-v1.schema.json",
  "title": "DataMiner deployment delta",
  "description": "Version 1 metadata-only deployment delta between two immutable AI content manifests.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "format",
    "visibility",
    "generator",
    "schema",
    "source",
    "retention",
    "license",
    "counts",
    "empty",
    "events",
    "redirects",
    "tombstones",
    "gaps"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "format": {
      "const": "json"
    },
    "visibility": {
      "const": "metadata-only"
    },
    "generator": {
      "$ref": "#/$defs/generator"
    },
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "const": "contributing/metadata/deployment-delta-v1.schema.json"
        },
        "version": {
          "const": 1
        }
      }
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "days",
        "policy",
        "tombstoneSemantics"
      ],
      "properties": {
        "days": {
          "const": 90
        },
        "policy": {
          "const": "protected-main-commit-addressed"
        },
        "tombstoneSemantics": {
          "const": "retain-removed-uid-url-identities"
        }
      }
    },
    "license": {
      "$ref": "#/$defs/license"
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "added",
        "changed",
        "moved",
        "deprecated",
        "removed",
        "ambiguousMoves",
        "redirects",
        "tombstones",
        "total"
      ],
      "properties": {
        "added": {
          "type": "integer",
          "minimum": 0
        },
        "changed": {
          "type": "integer",
          "minimum": 0
        },
        "moved": {
          "type": "integer",
          "minimum": 0
        },
        "deprecated": {
          "type": "integer",
          "minimum": 0
        },
        "removed": {
          "type": "integer",
          "minimum": 0
        },
        "ambiguousMoves": {
          "type": "integer",
          "minimum": 0
        },
        "redirects": {
          "type": "integer",
          "minimum": 0
        },
        "tombstones": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "empty": {
      "type": "boolean"
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "redirects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/redirect"
      }
    },
    "tombstones": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/tombstone"
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/gap"
      }
    }
  },
  "$defs": {
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "const": "scripts/generate-deployment-delta.ps1"
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "fileReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "available"
      ],
      "properties": {
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "available": {
          "type": "boolean"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "currentRevision",
        "previousRevision",
        "baseUrl",
        "currentManifest",
        "previousManifest"
      ],
      "properties": {
        "repository": {
          "const": "SkylineCommunications/dataminer-docs"
        },
        "currentRevision": {
          "$ref": "#/$defs/commit"
        },
        "previousRevision": {
          "anyOf": [
            {
              "$ref": "#/$defs/commit"
            },
            {
              "type": "null"
            }
          ]
        },
        "baseUrl": {
          "type": "string",
          "format": "uri"
        },
        "currentManifest": {
          "$ref": "#/$defs/fileReference"
        },
        "previousManifest": {
          "$ref": "#/$defs/fileReference"
        }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identifier",
        "name",
        "url",
        "attribution",
        "source"
      ],
      "properties": {
        "identifier": {
          "const": "CC BY-NC-ND 4.0"
        },
        "name": {
          "const": "Creative Commons Attribution-NonCommercial-NoDerivatives 4.0 International"
        },
        "url": {
          "const": "https://creativecommons.org/licenses/by-nc-nd/4.0/"
        },
        "attribution": {
          "const": "Skyline Communications"
        },
        "source": {
          "const": "contributing/CTB_Documentation_Corpus_Policy.md"
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uid",
        "url"
      ],
      "properties": {
        "uid": {
          "type": "string",
          "enum": [
            "stable",
            "unknown",
            "not_applicable"
          ]
        },
        "url": {
          "type": "string",
          "enum": [
            "stable",
            "unknown",
            "redirect_required",
            "not_applicable"
          ]
        },
        "urlAliases": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uid",
        "url",
        "sourcePath",
        "sourceCommit",
        "sourceBlob",
        "contentHash",
        "type",
        "area",
        "domain",
        "authority",
        "authoritySource",
        "lifecycle",
        "appliesTo",
        "version",
        "compatibility",
        "license",
        "attribution",
        "xrefs",
        "dependencies"
      ],
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "sourcePath": {
          "type": "string",
          "minLength": 1
        },
        "sourceCommit": {
          "$ref": "#/$defs/commit"
        },
        "sourceBlob": {
          "type": "string",
          "format": "uri"
        },
        "contentHash": {
          "$ref": "#/$defs/hash"
        },
        "type": {
          "type": "string",
          "enum": [
            "conceptual",
            "schema",
            "api",
            "example",
            "release-note",
            "legacy"
          ]
        },
        "area": {
          "type": "string",
          "enum": [
            "root",
            "dataminer",
            "develop",
            "solutions",
            "tutorials",
            "connectors",
            "release-notes",
            "contributing",
            "unknown"
          ]
        },
        "domain": {
          "type": "string",
          "minLength": 1
        },
        "authority": {
          "type": "string",
          "enum": [
            "canonical",
            "reference",
            "illustrative",
            "historical",
            "unknown",
            "not_applicable"
          ]
        },
        "authoritySource": {
          "type": "string",
          "minLength": 1
        },
        "lifecycle": {
          "type": "string",
          "enum": [
            "draft",
            "active",
            "deprecated",
            "archived",
            "unknown"
          ]
        },
        "appliesTo": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "compatibility": {
          "$ref": "#/$defs/compatibility"
        },
        "license": {
          "const": "CC BY-NC-ND 4.0"
        },
        "attribution": {
          "const": "Skyline Communications"
        },
        "xrefs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "uid",
        "current",
        "previous",
        "candidates",
        "reason",
        "moved",
        "contentChanged",
        "tombstone"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "added",
            "changed",
            "moved",
            "deprecated",
            "removed",
            "ambiguous-move"
          ]
        },
        "uid": {
          "type": "string",
          "minLength": 1
        },
        "current": {
          "anyOf": [
            {
              "$ref": "#/$defs/identity"
            },
            {
              "type": "null"
            }
          ]
        },
        "previous": {
          "anyOf": [
            {
              "$ref": "#/$defs/identity"
            },
            {
              "type": "null"
            }
          ]
        },
        "candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identity"
          }
        },
        "reason": {
          "type": "string",
          "enum": [
            "new-entry",
            "content-hash-changed",
            "identity-or-url-changed",
            "lifecycle-transition",
            "entry-removed",
            "ambiguous-identity-match"
          ]
        },
        "moved": {
          "type": "boolean"
        },
        "contentChanged": {
          "type": "boolean"
        },
        "tombstone": {
          "type": "boolean"
        }
      }
    },
    "redirect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "previousUid",
        "currentUid",
        "previousSourcePath",
        "currentSourcePath",
        "status",
        "reason",
        "license",
        "attribution"
      ],
      "properties": {
        "from": {
          "type": "string",
          "format": "uri"
        },
        "to": {
          "type": "string",
          "format": "uri"
        },
        "previousUid": {
          "type": "string",
          "minLength": 1
        },
        "currentUid": {
          "type": "string",
          "minLength": 1
        },
        "previousSourcePath": {
          "type": "string",
          "minLength": 1
        },
        "currentSourcePath": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "const": "permanent"
        },
        "reason": {
          "const": "published-url-changed"
        },
        "license": {
          "const": "CC BY-NC-ND 4.0"
        },
        "attribution": {
          "const": "Skyline Communications"
        }
      }
    },
    "tombstone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uid",
        "url",
        "sourcePath",
        "sourceCommit",
        "sourceBlob",
        "contentHash",
        "license",
        "attribution",
        "removedInCommit",
        "retentionDays"
      ],
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "sourcePath": {
          "type": "string",
          "minLength": 1
        },
        "sourceCommit": {
          "$ref": "#/$defs/commit"
        },
        "sourceBlob": {
          "type": "string",
          "format": "uri"
        },
        "contentHash": {
          "$ref": "#/$defs/hash"
        },
        "license": {
          "const": "CC BY-NC-ND 4.0"
        },
        "attribution": {
          "const": "Skyline Communications"
        },
        "removedInCommit": {
          "$ref": "#/$defs/commit"
        },
        "retentionDays": {
          "const": 90
        }
      }
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "count"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "count": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
