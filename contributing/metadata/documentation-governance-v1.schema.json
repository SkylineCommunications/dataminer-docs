{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/SkylineCommunications/dataminer-docs/main/contributing/metadata/documentation-governance-v1.schema.json",
  "title": "DataMiner documentation governance policy",
  "description": "Version 1 machine-readable review cadence and workstream policy for DataMiner documentation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "policy",
    "accountableOwner",
    "accountableOwnerHandle",
    "ownerHandleFollowUp",
    "metadataExpectations",
    "cadenceProfiles",
    "workstreams"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri-reference"
    },
    "schemaVersion": {
      "const": 1
    },
    "policy": {
      "const": "D6.1"
    },
    "accountableOwner": {
      "const": "Docs Writing Team"
    },
    "accountableOwnerHandle": {
      "type": "string",
      "enum": [
        "unknown",
        "not_applicable"
      ],
      "description": "The exact team handle is intentionally unresolved until it is confirmed."
    },
    "ownerHandleFollowUp": {
      "type": "string",
      "minLength": 1
    },
    "metadataExpectations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requiredFields",
        "ownerSentinels",
        "reviewStatuses",
        "unknownValuesRequireFollowUp"
      ],
      "properties": {
        "requiredFields": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "ownerSentinels": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "unknown",
              "not_applicable"
            ]
          }
        },
        "reviewStatuses": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "draft",
              "in_review",
              "approved",
              "needs_update",
              "unknown",
              "not_applicable"
            ]
          }
        },
        "unknownValuesRequireFollowUp": {
          "type": "boolean"
        }
      }
    },
    "cadenceProfiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/cadenceProfile"
      }
    },
    "workstreams": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/workstream"
      }
    }
  },
  "$defs": {
    "cadenceProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "workstreams",
        "authorities",
        "contentTypes",
        "reviewEveryDays",
        "staleAfterDays"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "workstreams": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "authorities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "*",
              "canonical",
              "reference",
              "illustrative",
              "historical",
              "unknown",
              "not_applicable"
            ]
          }
        },
        "contentTypes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "*",
              "conceptual",
              "schema",
              "api",
              "example",
              "release-note",
              "legacy"
            ]
          }
        },
        "reviewEveryDays": {
          "type": "integer",
          "minimum": 1
        },
        "staleAfterDays": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "workstream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "pathPatterns",
        "evidencePaths"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "pathPatterns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidencePaths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
