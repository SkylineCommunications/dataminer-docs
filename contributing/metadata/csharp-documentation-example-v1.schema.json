{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/SkylineCommunications/dataminer-docs/main/contributing/metadata/csharp-documentation-example-v1.schema.json",
  "title": "DataMiner C# documentation example validation manifest",
  "description": "Version 1 metadata contract for deterministic classification and compilation results for C# code blocks in a bounded documentation scope.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "format",
    "generator",
    "schema",
    "source",
    "scope",
    "generation",
    "counts",
    "gaps",
    "examples"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "format": {
      "const": "csharp-documentation-examples"
    },
    "generator": {
      "$ref": "#/$defs/generator"
    },
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "const": "contributing/metadata/csharp-documentation-example-v1.schema.json"
        },
        "version": {
          "const": 1
        }
      }
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "generation": {
      "$ref": "#/$defs/generation"
    },
    "counts": {
      "$ref": "#/$defs/counts"
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "examples": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/example"
      }
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^(unknown|[0-9a-f]{40})$"
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "const": "scripts/generate-csharp-documentation-examples.ps1"
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "revision",
        "revisionSource"
      ],
      "properties": {
        "repository": {
          "const": "SkylineCommunications/dataminer-docs"
        },
        "revision": {
          "$ref": "#/$defs/commit"
        },
        "revisionSource": {
          "enum": [
            "argument",
            "environment",
            "git",
            "unknown"
          ]
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "configuration",
        "include",
        "exclude",
        "coverage"
      ],
      "properties": {
        "mode": {
          "const": "bounded-representative"
        },
        "configuration": {
          "$ref": "#/$defs/fileReference"
        },
        "include": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "exclude": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "coverage": {
          "$ref": "#/$defs/coverage"
        }
      }
    },
    "fileReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pageCount",
        "csharpBlockCount",
        "fullCorpusAudited",
        "notes"
      ],
      "properties": {
        "pageCount": {
          "type": "integer",
          "minimum": 0
        },
        "csharpBlockCount": {
          "type": "integer",
          "minimum": 0
        },
        "fullCorpusAudited": {
          "const": false
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deterministic",
        "contentHashAlgorithm",
        "generatedContent"
      ],
      "properties": {
        "deterministic": {
          "const": true
        },
        "contentHashAlgorithm": {
          "const": "sha256"
        },
        "generatedContent": {
          "type": "array",
          "const": [
            "complete-example-projects"
          ]
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pageCount",
        "csharpBlockCount",
        "complete",
        "fragment",
        "pseudocode",
        "invalidMetadata",
        "compiled",
        "failed",
        "notAttempted"
      ],
      "properties": {
        "pageCount": {
          "type": "integer",
          "minimum": 0
        },
        "csharpBlockCount": {
          "type": "integer",
          "minimum": 0
        },
        "complete": {
          "type": "integer",
          "minimum": 0
        },
        "fragment": {
          "type": "integer",
          "minimum": 0
        },
        "pseudocode": {
          "type": "integer",
          "minimum": 0
        },
        "invalidMetadata": {
          "type": "integer",
          "minimum": 0
        },
        "compiled": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "notAttempted": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "framework",
        "packages"
      ],
      "properties": {
        "classification": {
          "type": "string",
          "minLength": 1
        },
        "framework": {
          "type": "string",
          "minLength": 1
        },
        "packages": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9][A-Za-z0-9+.-]*$"
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason",
        "projectPath",
        "sourcePath",
        "assemblyPath",
        "diagnosticHash"
      ],
      "properties": {
        "status": {
          "enum": [
            "compiled",
            "failed",
            "not-attempted"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "projectPath": {
          "type": "string",
          "minLength": 1
        },
        "sourcePath": {
          "type": "string",
          "minLength": 1
        },
        "assemblyPath": {
          "type": "string",
          "minLength": 1
        },
        "diagnosticHash": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "example": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sourcePage",
        "sourceUid",
        "codeBlockIndex",
        "sourceLineStart",
        "sourceLineEnd",
        "sourcePageHash",
        "sourceCodeHash",
        "language",
        "declaredClassification",
        "classification",
        "classificationSource",
        "metadata",
        "targetFramework",
        "packages",
        "classificationReason",
        "result"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sourcePage": {
          "type": "string",
          "minLength": 1
        },
        "sourceUid": {
          "type": "string",
          "minLength": 1
        },
        "codeBlockIndex": {
          "type": "integer",
          "minimum": 1
        },
        "sourceLineStart": {
          "type": "integer",
          "minimum": 1
        },
        "sourceLineEnd": {
          "type": "integer",
          "minimum": 1
        },
        "sourcePageHash": {
          "$ref": "#/$defs/hash"
        },
        "sourceCodeHash": {
          "$ref": "#/$defs/hash"
        },
        "language": {
          "enum": [
            "csharp",
            "cs",
            "c#"
          ]
        },
        "declaredClassification": {
          "type": "string",
          "minLength": 1
        },
        "classification": {
          "enum": [
            "complete",
            "fragment",
            "pseudocode"
          ]
        },
        "classificationSource": {
          "enum": [
            "fence-info",
            "comment",
            "missing"
          ]
        },
        "metadata": {
          "$ref": "#/$defs/metadata"
        },
        "targetFramework": {
          "type": "string",
          "minLength": 1
        },
        "packages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/package"
          }
        },
        "classificationReason": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "$ref": "#/$defs/result"
        }
      }
    }
  }
}
