{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/SkylineCommunications/dataminer-docs/main/contributing/metadata/documentation-metrics-v1.schema.json",
  "title": "DataMiner documentation quality and synchronization metrics",
  "description": "Version 1 metadata-only D6.3 quality and synchronization report for deterministic D2-D6 evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "policy",
    "format",
    "visibility",
    "generator",
    "schema",
    "identity",
    "source",
    "retention",
    "protection",
    "scope",
    "artifacts",
    "metrics",
    "gaps",
    "summary"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri-reference"
    },
    "schemaVersion": {
      "const": 1
    },
    "policy": {
      "const": "D6.3"
    },
    "format": {
      "const": "json"
    },
    "visibility": {
      "const": "repository-metadata"
    },
    "generator": {
      "$ref": "#/$defs/generator"
    },
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "const": "contributing/metadata/documentation-metrics-v1.schema.json"
        },
        "version": {
          "const": 1
        }
      }
    },
    "identity": {
      "$ref": "#/$defs/identity"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "retention": {
      "$ref": "#/$defs/retention"
    },
    "protection": {
      "$ref": "#/$defs/protection"
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metadataCoverage",
        "uidUrlLinkHealth",
        "snippetValidation",
        "qualityGates",
        "safety",
        "generatedProvenance",
        "governance",
        "coupling",
        "sourceDocumentationDelta",
        "agentSync"
      ],
      "properties": {
        "metadataCoverage": {
          "$ref": "#/$defs/metric"
        },
        "uidUrlLinkHealth": {
          "$ref": "#/$defs/metric"
        },
        "snippetValidation": {
          "$ref": "#/$defs/metric"
        },
        "qualityGates": {
          "$ref": "#/$defs/metric"
        },
        "safety": {
          "$ref": "#/$defs/metric"
        },
        "generatedProvenance": {
          "$ref": "#/$defs/metric"
        },
        "governance": {
          "$ref": "#/$defs/metric"
        },
        "coupling": {
          "$ref": "#/$defs/metric"
        },
        "sourceDocumentationDelta": {
          "$ref": "#/$defs/deltaMetric"
        },
        "agentSync": {
          "$ref": "#/$defs/metric"
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/gap"
      }
    },
    "summary": {
      "$ref": "#/$defs/summary"
    }
  },
  "$defs": {
    "countValue": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "number",
          "minimum": 0
        },
        {
          "enum": [
            "unknown",
            "not_available"
          ]
        }
      ]
    },
    "dateOrUnknown": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        {
          "const": "unknown"
        }
      ]
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "const": "scripts/generate-documentation-metrics.ps1"
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "value",
        "materialVersion"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "value": {
          "$ref": "#/$defs/hash"
        },
        "materialVersion": {
          "const": 1
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "revision",
        "revisionSource",
        "generatedAt",
        "generatedAtSource"
      ],
      "properties": {
        "repository": {
          "const": "SkylineCommunications/dataminer-docs"
        },
        "revision": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            {
              "const": "unknown"
            }
          ]
        },
        "revisionSource": {
          "enum": [
            "argument",
            "git",
            "unknown"
          ]
        },
        "generatedAt": {
          "$ref": "#/$defs/dateOrUnknown"
        },
        "generatedAtSource": {
          "enum": [
            "argument",
            "source_date_epoch",
            "git_commit",
            "unknown"
          ]
        }
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "artifactClass",
        "retentionDays",
        "publication"
      ],
      "properties": {
        "policy": {
          "const": "approved-ci-evidence"
        },
        "artifactClass": {
          "const": "d6-metrics"
        },
        "retentionDays": {
          "const": 90
        },
        "publication": {
          "const": "protected-main-or-scheduled"
        }
      }
    },
    "protection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metadataOnly",
        "transformedProseIncluded",
        "secretsIncluded"
      ],
      "properties": {
        "metadataOnly": {
          "const": true
        },
        "transformedProseIncluded": {
          "const": false
        },
        "secretsIncluded": {
          "const": false
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domains",
        "domainMetrics"
      ],
      "properties": {
        "domains": {
          "const": [
            "Automation",
            "Connector"
          ]
        },
        "domainMetrics": {
          "const": "separate-where-evidence-exists"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "status",
        "available",
        "sha256",
        "schemaVersion"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "available",
            "not_available",
            "invalid"
          ]
        },
        "available": {
          "type": "boolean"
        },
        "sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/hash"
            },
            {
              "const": "unknown"
            }
          ]
        },
        "schemaVersion": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "const": "unknown"
            }
          ]
        }
      }
    },
    "countMap": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/countValue"
      }
    },
    "domainMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain",
        "status",
        "counts"
      ],
      "properties": {
        "domain": {
          "enum": [
            "Automation",
            "Connector"
          ]
        },
        "status": {
          "enum": [
            "available",
            "partial",
            "not_available"
          ]
        },
        "counts": {
          "$ref": "#/$defs/countMap"
        }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "sourceArtifacts",
        "counts",
        "byDomain"
      ],
      "properties": {
        "status": {
          "enum": [
            "available",
            "partial",
            "not_available"
          ]
        },
        "sourceArtifacts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "empty": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "enum": [
                "unknown",
                "not_available"
              ]
            }
          ]
        },
        "counts": {
          "$ref": "#/$defs/countMap"
        },
        "byDomain": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/domainMetric"
          }
        }
      }
    },
    "deltaMetric": {
      "allOf": [
        {
          "$ref": "#/$defs/metric"
        },
        {
          "required": [
            "empty"
          ]
        }
      ]
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "sourceArtifact",
        "count",
        "domain",
        "status"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "sourceArtifact": {
          "type": "string",
          "minLength": 1
        },
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "domain": {
          "enum": [
            "Automation",
            "Connector",
            "unknown"
          ]
        },
        "status": {
          "enum": [
            "unresolved",
            "not_available",
            "pre_existing"
          ]
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactCount",
        "availableArtifacts",
        "unavailableArtifacts",
        "invalidArtifacts",
        "metricCount",
        "availableMetrics",
        "gapRecords",
        "unresolvedGaps",
        "notAvailableGaps",
        "emptyDelta",
        "reportIdentity"
      ],
      "properties": {
        "artifactCount": {
          "type": "integer",
          "minimum": 0
        },
        "availableArtifacts": {
          "type": "integer",
          "minimum": 0
        },
        "unavailableArtifacts": {
          "type": "integer",
          "minimum": 0
        },
        "invalidArtifacts": {
          "type": "integer",
          "minimum": 0
        },
        "metricCount": {
          "const": 10
        },
        "availableMetrics": {
          "type": "integer",
          "minimum": 0
        },
        "gapRecords": {
          "type": "integer",
          "minimum": 0
        },
        "unresolvedGaps": {
          "type": "integer",
          "minimum": 0
        },
        "notAvailableGaps": {
          "type": "integer",
          "minimum": 0
        },
        "emptyDelta": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "enum": [
                "unknown",
                "not_available"
              ]
            }
          ]
        },
        "reportIdentity": {
          "$ref": "#/$defs/hash"
        }
      }
    }
  }
}
