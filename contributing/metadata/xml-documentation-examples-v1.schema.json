{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/SkylineCommunications/dataminer-docs/main/contributing/metadata/xml-documentation-examples-v1.schema.json",
  "title": "DataMiner XML documentation examples validation report",
  "description": "Version 1 metadata contract for deterministic Protocol and Automation XML documentation-example validation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "format",
    "generator",
    "source",
    "scope",
    "generation",
    "schemas",
    "counts",
    "examples",
    "gaps"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "format": {
      "const": "xml-documentation-examples"
    },
    "generator": {
      "$ref": "#/$defs/generator"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "generation": {
      "$ref": "#/$defs/generation"
    },
    "schemas": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/schemaEvidence"
      }
    },
    "counts": {
      "$ref": "#/$defs/counts"
    },
    "examples": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/example"
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/gap"
      }
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "const": "scripts/generate-xml-documentation-examples.ps1"
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "revision",
        "revisionSource",
        "configuration"
      ],
      "properties": {
        "repository": {
          "const": "SkylineCommunications/dataminer-docs"
        },
        "revision": {
          "oneOf": [
            {
              "$ref": "#/$defs/commit"
            },
            {
              "const": "unknown"
            }
          ]
        },
        "revisionSource": {
          "type": "string",
          "enum": [
            "argument",
            "git",
            "unknown"
          ]
        },
        "configuration": {
          "$ref": "#/$defs/fileReference"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "language",
        "domains",
        "sourcePaths"
      ],
      "properties": {
        "language": {
          "const": "xml"
        },
        "domains": {
          "type": "array",
          "const": [
            "Automation",
            "Protocol"
          ]
        },
        "sourcePaths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generatedAt",
        "generatedAtSource",
        "deterministic",
        "contentIdentityAlgorithm",
        "contentIdentityFields",
        "contentIdentityExcludes"
      ],
      "properties": {
        "generatedAt": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            {
              "const": "unknown"
            }
          ]
        },
        "generatedAtSource": {
          "type": "string",
          "enum": [
            "argument",
            "source_date_epoch",
            "unknown"
          ]
        },
        "deterministic": {
          "const": true
        },
        "contentIdentityAlgorithm": {
          "const": "sha256"
        },
        "contentIdentityFields": {
          "type": "array",
          "const": [
            "sourceRevision",
            "sourcePath",
            "sourceLine",
            "sourceContentHash",
            "schemaId",
            "wrapperId"
          ]
        },
        "contentIdentityExcludes": {
          "type": "array",
          "const": [
            "generatedAt"
          ]
        }
      }
    },
    "fileReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "schemaEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "domain",
        "rootElement",
        "namespace",
        "version",
        "versionEvidence",
        "source",
        "available"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "domain": {
          "type": "string",
          "enum": [
            "Automation",
            "Protocol"
          ]
        },
        "rootElement": {
          "type": "string",
          "minLength": 1
        },
        "namespace": {
          "type": "string",
          "format": "uri"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "versionEvidence": {
          "$ref": "#/$defs/versionEvidence"
        },
        "source": {
          "$ref": "#/$defs/schemaSource"
        },
        "available": {
          "type": "boolean"
        }
      }
    },
    "versionEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourcePage",
        "sourceLine",
        "status",
        "note"
      ],
      "properties": {
        "sourcePage": {
          "type": "string",
          "minLength": 1
        },
        "sourceLine": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "published",
            "not-published"
          ]
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "schemaSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit",
        "files"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "$ref": "#/$defs/commit"
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/schemaFile"
          }
        }
      }
    },
    "schemaFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "role",
        "url",
        "sha256",
        "available"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "enum": [
            "entry",
            "dependency"
          ]
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "sha256": {
          "$ref": "#/$defs/hash"
        },
        "available": {
          "type": "boolean"
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourcePages",
        "examples",
        "completeDocuments",
        "fragments",
        "passed",
        "expectedFailures",
        "failed",
        "unverified",
        "repairedFragments",
        "gaps",
        "byDomain"
      ],
      "properties": {
        "sourcePages": {
          "type": "integer",
          "minimum": 0
        },
        "examples": {
          "type": "integer",
          "minimum": 0
        },
        "completeDocuments": {
          "type": "integer",
          "minimum": 0
        },
        "fragments": {
          "type": "integer",
          "minimum": 0
        },
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "expectedFailures": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "unverified": {
          "type": "integer",
          "minimum": 0
        },
        "repairedFragments": {
          "type": "integer",
          "minimum": 0
        },
        "gaps": {
          "type": "integer",
          "minimum": 0
        },
        "byDomain": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/domainCounts"
          }
        }
      }
    },
    "domainCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain",
        "examples",
        "completeDocuments",
        "fragments",
        "passed",
        "expectedFailures",
        "failed",
        "unverified"
      ],
      "properties": {
        "domain": {
          "type": "string",
          "enum": [
            "Automation",
            "Protocol"
          ]
        },
        "examples": {
          "type": "integer",
          "minimum": 0
        },
        "completeDocuments": {
          "type": "integer",
          "minimum": 0
        },
        "fragments": {
          "type": "integer",
          "minimum": 0
        },
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "expectedFailures": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "unverified": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "example": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "domain",
        "source",
        "classification",
        "negative",
        "contentHash",
        "schema",
        "wrapper",
        "result"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^example-[0-9a-f]{24}$"
        },
        "domain": {
          "type": "string",
          "enum": [
            "Automation",
            "Protocol"
          ]
        },
        "source": {
          "$ref": "#/$defs/exampleSource"
        },
        "classification": {
          "$ref": "#/$defs/classification"
        },
        "negative": {
          "type": "boolean"
        },
        "contentHash": {
          "$ref": "#/$defs/hash"
        },
        "schema": {
          "$ref": "#/$defs/exampleSchema"
        },
        "wrapper": {
          "$ref": "#/$defs/wrapper"
        },
        "result": {
          "$ref": "#/$defs/result"
        }
      }
    },
    "exampleSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "uid",
        "startLine",
        "endLine",
        "fenceLine"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "uid": {
          "type": "string",
          "minLength": 1
        },
        "startLine": {
          "type": "integer",
          "minimum": 1
        },
        "endLine": {
          "type": "integer",
          "minimum": 1
        },
        "fenceLine": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "reason",
        "rootElement",
        "namespace"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "complete",
            "fragment"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "rootElement": {
          "type": "string"
        },
        "namespace": {
          "type": "string"
        }
      }
    },
    "exampleSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "domain",
        "rootElement",
        "namespace",
        "version",
        "versionEvidence",
        "sourcePage",
        "sourceCommit",
        "sourceFilesAvailable"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "domain": {
          "type": "string",
          "enum": [
            "Automation",
            "Protocol"
          ]
        },
        "rootElement": {
          "type": "string",
          "minLength": 1
        },
        "namespace": {
          "type": "string",
          "format": "uri"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "versionEvidence": {
          "$ref": "#/$defs/versionEvidence"
        },
        "sourcePage": {
          "type": "string",
          "minLength": 1
        },
        "sourceCommit": {
          "$ref": "#/$defs/commit"
        },
        "sourceFilesAvailable": {
          "type": "boolean"
        }
      }
    },
    "wrapper": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "rootElement",
        "namespace",
        "applied",
        "validation",
        "normalized",
        "repaired"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "rootElement": {
          "type": "string",
          "minLength": 1
        },
        "namespace": {
          "type": "string",
          "format": "uri"
        },
        "applied": {
          "type": "boolean"
        },
        "validation": {
          "type": "string",
          "enum": [
            "xsd",
            "wrapped-well-formed",
            "not-applicable"
          ]
        },
        "normalized": {
          "type": "boolean"
        },
        "repaired": {
          "type": "boolean"
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "schemaStatus",
        "message"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "passed",
            "expected-failure",
            "failed",
            "unverified"
          ]
        },
        "schemaStatus": {
          "type": "string",
          "enum": [
            "valid",
            "invalid",
            "not-evaluated",
            "source-missing",
            "not-applicable"
          ]
        },
        "message": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "severity",
        "message"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "schema-source-missing",
            "schema-source-invalid",
            "fragment-wrapper-failed",
            "fragment-validation-not-applicable",
            "unclosed-xml-fence"
          ]
        },
        "severity": {
          "type": "string",
          "enum": [
            "warning",
            "error"
          ]
        },
        "domain": {
          "type": "string",
          "enum": [
            "Automation",
            "Protocol"
          ]
        },
        "sourcePath": {
          "type": "string",
          "minLength": 1
        },
        "sourceLine": {
          "type": "integer",
          "minimum": 1
        },
        "schemaId": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
