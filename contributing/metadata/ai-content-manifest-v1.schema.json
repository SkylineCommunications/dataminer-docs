{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/SkylineCommunications/dataminer-docs/main/contributing/metadata/ai-content-manifest-v1.schema.json",
  "title": "DataMiner AI content manifest",
  "description": "Version 1 metadata-only manifest for deterministic DataMiner documentation change discovery.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "format",
    "visibility",
    "generator",
    "schema",
    "source",
    "scope",
    "license",
    "counts",
    "entries",
    "gaps"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "format": {
      "const": "json"
    },
    "visibility": {
      "const": "metadata-only"
    },
    "generator": {
      "$ref": "#/$defs/generator"
    },
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "const": "contributing/metadata/ai-content-manifest-v1.schema.json"
        },
        "version": {
          "const": 1
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "revision",
        "revisionSource",
        "configuration",
        "baseUrl"
      ],
      "properties": {
        "repository": {
          "const": "SkylineCommunications/dataminer-docs"
        },
        "revision": {
          "$ref": "#/$defs/commit"
        },
        "revisionSource": {
          "type": "string",
          "enum": [
            "argument",
            "git"
          ]
        },
        "configuration": {
          "$ref": "#/$defs/file"
        },
        "baseUrl": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourcePaths",
        "domains"
      ],
      "properties": {
        "sourcePaths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "domains": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "license": {
      "$ref": "#/$defs/license"
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current",
        "added",
        "changed",
        "moved",
        "unchanged",
        "removed",
        "tombstones",
        "total"
      ],
      "properties": {
        "current": {
          "type": "integer",
          "minimum": 0
        },
        "added": {
          "type": "integer",
          "minimum": 0
        },
        "changed": {
          "type": "integer",
          "minimum": 0
        },
        "moved": {
          "type": "integer",
          "minimum": 0
        },
        "unchanged": {
          "type": "integer",
          "minimum": 0
        },
        "removed": {
          "type": "integer",
          "minimum": 0
        },
        "tombstones": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/gap"
      }
    }
  },
  "$defs": {
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "const": "scripts/generate-ai-content-manifest.ps1"
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identifier",
        "name",
        "url",
        "attribution",
        "source"
      ],
      "properties": {
        "identifier": {
          "const": "CC BY-NC-ND 4.0"
        },
        "name": {
          "const": "Creative Commons Attribution-NonCommercial-NoDerivatives 4.0 International"
        },
        "url": {
          "const": "https://creativecommons.org/licenses/by-nc-nd/4.0/"
        },
        "attribution": {
          "const": "Skyline Communications"
        },
        "source": {
          "const": "contributing/CTB_Documentation_Corpus_Policy.md"
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uid",
        "url"
      ],
      "properties": {
        "uid": {
          "type": "string",
          "enum": [
            "stable",
            "unknown",
            "not_applicable"
          ]
        },
        "url": {
          "type": "string",
          "enum": [
            "stable",
            "unknown",
            "redirect_required",
            "not_applicable"
          ]
        },
        "urlAliases": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "previous": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourcePath",
        "url",
        "sourceCommit",
        "sourceBlob",
        "contentHash"
      ],
      "properties": {
        "sourcePath": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "sourceCommit": {
          "$ref": "#/$defs/commit"
        },
        "sourceBlob": {
          "type": "string",
          "format": "uri"
        },
        "contentHash": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uid",
        "url",
        "sourcePath",
        "sourceCommit",
        "sourceBlob",
        "contentHash",
        "type",
        "area",
        "domain",
        "authority",
        "authoritySource",
        "lifecycle",
        "appliesTo",
        "version",
        "compatibility",
        "license",
        "attribution",
        "xrefs",
        "dependencies",
        "changeType",
        "tombstone",
        "moved"
      ],
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "sourcePath": {
          "type": "string",
          "minLength": 1
        },
        "sourceCommit": {
          "$ref": "#/$defs/commit"
        },
        "sourceBlob": {
          "type": "string",
          "format": "uri"
        },
        "contentHash": {
          "$ref": "#/$defs/hash"
        },
        "type": {
          "type": "string",
          "enum": [
            "conceptual",
            "schema",
            "api",
            "example",
            "release-note",
            "legacy"
          ]
        },
        "area": {
          "type": "string",
          "enum": [
            "root",
            "dataminer",
            "develop",
            "solutions",
            "tutorials",
            "connectors",
            "release-notes",
            "contributing",
            "unknown"
          ]
        },
        "domain": {
          "type": "string",
          "minLength": 1
        },
        "authority": {
          "type": "string",
          "enum": [
            "canonical",
            "reference",
            "illustrative",
            "historical",
            "unknown",
            "not_applicable"
          ]
        },
        "authoritySource": {
          "type": "string",
          "minLength": 1
        },
        "lifecycle": {
          "type": "string",
          "enum": [
            "draft",
            "active",
            "deprecated",
            "archived",
            "unknown"
          ]
        },
        "appliesTo": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "compatibility": {
          "$ref": "#/$defs/compatibility"
        },
        "license": {
          "const": "CC BY-NC-ND 4.0"
        },
        "attribution": {
          "const": "Skyline Communications"
        },
        "xrefs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "changeType": {
          "type": "string",
          "enum": [
            "added",
            "changed",
            "moved",
            "unchanged",
            "removed"
          ]
        },
        "tombstone": {
          "type": "boolean"
        },
        "moved": {
          "type": "boolean"
        },
        "removedInCommit": {
          "$ref": "#/$defs/commit"
        },
        "previous": {
          "$ref": "#/$defs/previous"
        }
      }
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "count"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "count": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
