{
  "$schema": "documentation-governance-v1.schema.json",
  "schemaVersion": 1,
  "policy": "D6.1",
  "accountableOwner": "Docs Writing Team",
  "accountableOwnerHandle": "unknown",
  "ownerHandleFollowUp": "Confirm the exact GitHub team handle for the Docs Writing Team before replacing the existing CODEOWNERS route.",
  "metadataExpectations": {
    "requiredFields": [
      "metadata_version",
      "authority",
      "content_type",
      "lifecycle",
      "owner",
      "review_status",
      "review_date"
    ],
    "ownerSentinels": [
      "unknown",
      "not_applicable"
    ],
    "reviewStatuses": [
      "draft",
      "in_review",
      "approved",
      "needs_update",
      "unknown",
      "not_applicable"
    ],
    "unknownValuesRequireFollowUp": true
  },
  "cadenceProfiles": [
    {
      "id": "generated-high-frequency",
      "label": "Generated API and schema",
      "workstreams": [
        "schema-api-generation",
        "connector",
        "automation"
      ],
      "authorities": [
        "canonical",
        "reference"
      ],
      "contentTypes": [
        "schema",
        "api"
      ],
      "reviewEveryDays": 90,
      "staleAfterDays": 120
    },
    {
      "id": "package-tooling-high-frequency",
      "label": "Package and tooling",
      "workstreams": [
        "package-tooling"
      ],
      "authorities": [
        "canonical",
        "reference"
      ],
      "contentTypes": [
        "*"
      ],
      "reviewEveryDays": 90,
      "staleAfterDays": 120
    },
    {
      "id": "connector-normative",
      "label": "Connector normative guidance",
      "workstreams": [
        "connector"
      ],
      "authorities": [
        "canonical",
        "reference"
      ],
      "contentTypes": [
        "conceptual",
        "schema",
        "api"
      ],
      "reviewEveryDays": 180,
      "staleAfterDays": 270
    },
    {
      "id": "automation-normative",
      "label": "Automation normative guidance",
      "workstreams": [
        "automation"
      ],
      "authorities": [
        "canonical",
        "reference"
      ],
      "contentTypes": [
        "conceptual",
        "schema",
        "api"
      ],
      "reviewEveryDays": 180,
      "staleAfterDays": 270
    },
    {
      "id": "docs-platform",
      "label": "Documentation platform",
      "workstreams": [
        "docs-platform"
      ],
      "authorities": [
        "canonical",
        "reference"
      ],
      "contentTypes": [
        "*"
      ],
      "reviewEveryDays": 180,
      "staleAfterDays": 270
    },
    {
      "id": "illustrative-low-frequency",
      "label": "Illustrative and example content",
      "workstreams": [
        "*"
      ],
      "authorities": [
        "illustrative"
      ],
      "contentTypes": [
        "example",
        "*"
      ],
      "reviewEveryDays": 365,
      "staleAfterDays": 540
    },
    {
      "id": "legacy-historical",
      "label": "Legacy and historical content",
      "workstreams": [
        "*"
      ],
      "authorities": [
        "historical"
      ],
      "contentTypes": [
        "legacy",
        "release-note",
        "*"
      ],
      "reviewEveryDays": 730,
      "staleAfterDays": 1095
    }
  ],
  "workstreams": [
    {
      "id": "connector",
      "label": "Connector",
      "pathPatterns": [
        "^develop/devguide/Connector/.*\\.md$",
        "^develop/schemadoc/Protocol/.*\\.md$",
        "^develop/codingguidelines/Protocol/.*\\.md$",
        "^develop/TOOLS/DIS/.*\\.md$"
      ],
      "evidencePaths": [
        "contributing/metadata/d2-2-migration-scope.json",
        "d2-2-metadata-migration-report.json"
      ]
    },
    {
      "id": "automation",
      "label": "Automation",
      "pathPatterns": [
        "^develop/devguide/Automation/.*\\.md$",
        "^develop/schemadoc/Automation/.*\\.md$",
        "^dataminer/Functions/Automation_module/.*\\.md$",
        "^develop/api/.*(Automation|ScriptParam|Interactivity).*\\.md$"
      ],
      "evidencePaths": [
        "contributing/metadata/d2-2-migration-scope.json",
        "d2-2-metadata-migration-report.json"
      ]
    },
    {
      "id": "schema-api-generation",
      "label": "Schema and API generation",
      "pathPatterns": [
        "^develop/api/.*\\.md$",
        "^develop/schemadoc/.*\\.md$"
      ],
      "evidencePaths": [
        "scripts/generate-generated-metadata-provenance.ps1",
        "scripts/validate-generated-metadata-provenance.ps1",
        "contributing/metadata/generated-metadata-provenance-v1.schema.json"
      ]
    },
    {
      "id": "package-tooling",
      "label": "Package and tooling",
      "pathPatterns": [
        "^develop/TOOLS/.*\\.md$",
        "^src/.*\\.md$",
        "^scripts/.*\\.md$"
      ],
      "evidencePaths": [
        "src/NuGetPackages",
        "buildDocs.cmd",
        "scripts/validate-documentation-metadata.ps1"
      ]
    },
    {
      "id": "docs-platform",
      "label": "Documentation platform",
      "pathPatterns": [
        "^contributing/.*\\.md$",
        "^README\\.md$"
      ],
      "evidencePaths": [
        ".github/CODEOWNERS",
        ".github/workflows/azure-static-web-apps-victorious-sea-0e7978f03.yml",
        "docfx.json",
        "buildDocs.cmd"
      ]
    },
    {
      "id": "legacy-historical",
      "label": "Legacy and historical content",
      "pathPatterns": [],
      "evidencePaths": []
    }
  ]
}
