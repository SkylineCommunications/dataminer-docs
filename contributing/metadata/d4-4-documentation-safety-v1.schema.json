{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.dataminer.services/schemas/d4-4-documentation-safety-v1.schema.json",
  "title": "DataMiner Docs D4.4 documentation safety report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "gate",
    "repository",
    "rules",
    "scope",
    "checks",
    "summary",
    "findings",
    "gaps"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "gate": {
      "const": "D4.4"
    },
    "repository": {
      "const": "SkylineCommunications/dataminer-docs"
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "schemaVersion",
        "authoritySources"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "schemaVersion": {
          "const": 1
        },
        "authoritySources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseRevision",
        "sourcePaths",
        "generatedRoots",
        "internalOnlyRoots"
      ],
      "properties": {
        "baseRevision": {
          "type": "string"
        },
        "sourcePaths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "generatedRoots": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "internalOnlyRoots": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "classification",
        "identityCompatibility",
        "legacyPolicy",
        "internalOnlyPolicy"
      ],
      "properties": {
        "authority": {
          "type": "string",
          "minLength": 1
        },
        "classification": {
          "type": "string",
          "minLength": 1
        },
        "identityCompatibility": {
          "type": "string",
          "minLength": 1
        },
        "legacyPolicy": {
          "type": "string",
          "minLength": 1
        },
        "internalOnlyPolicy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "files",
        "findings",
        "newFindings",
        "legacyExceptions",
        "allowlisted",
        "gaps",
        "newGaps",
        "preExistingGaps",
        "countsByCategory"
      ],
      "properties": {
        "files": {
          "type": "integer",
          "minimum": 0
        },
        "findings": {
          "type": "integer",
          "minimum": 0
        },
        "newFindings": {
          "type": "integer",
          "minimum": 0
        },
        "legacyExceptions": {
          "type": "integer",
          "minimum": 0
        },
        "allowlisted": {
          "type": "integer",
          "minimum": 0
        },
        "gaps": {
          "type": "integer",
          "minimum": 0
        },
        "newGaps": {
          "type": "integer",
          "minimum": 0
        },
        "preExistingGaps": {
          "type": "integer",
          "minimum": 0
        },
        "countsByCategory": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "ruleId",
          "category",
          "severity",
          "status",
          "path",
          "line",
          "column",
          "classification",
          "scope",
          "value",
          "details",
          "identity"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "ruleId": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "new",
              "legacy_exception",
              "allowlisted"
            ]
          },
          "path": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "column": {
            "type": "integer",
            "minimum": 1
          },
          "classification": {
            "type": "string"
          },
          "scope": {
            "type": "string",
            "enum": [
              "source",
              "generated-artifact",
              "internal-only-generated-artifact"
            ]
          },
          "value": {
            "type": "string"
          },
          "details": {
            "type": "string"
          },
          "identity": {
            "type": "string"
          },
          "allowlistId": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "status",
          "path",
          "line",
          "classification",
          "message",
          "identity"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "new",
              "pre_existing"
            ]
          },
          "path": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "classification": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "identity": {
            "type": "string"
          }
        }
      }
    }
  }
}
