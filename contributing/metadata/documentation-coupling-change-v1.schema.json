{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/SkylineCommunications/dataminer-docs/main/contributing/metadata/documentation-coupling-change-v1.schema.json",
  "title": "DataMiner product change coupling input",
  "description": "Version 1 caller-supplied metadata for matching a product change to affected DataMiner documentation and release checks.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "policy",
    "format",
    "visibility",
    "changeId",
    "source",
    "changeKinds",
    "changedPaths",
    "affectedDocumentation",
    "generatedReferences",
    "acknowledgement",
    "documentationUpdate",
    "dispatch"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri-reference"
    },
    "schemaVersion": {
      "const": 1
    },
    "policy": {
      "const": "D6.2"
    },
    "format": {
      "const": "json"
    },
    "visibility": {
      "const": "repository-metadata"
    },
    "changeId": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "changeKinds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "schema",
          "api",
          "package",
          "validator",
          "template",
          "behavior",
          "unknown"
        ]
      }
    },
    "changedPaths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "affectedDocumentation": {
      "$ref": "#/$defs/affectedDocumentation"
    },
    "generatedReferences": {
      "$ref": "#/$defs/generatedReferences"
    },
    "acknowledgement": {
      "$ref": "#/$defs/acknowledgement"
    },
    "documentationUpdate": {
      "$ref": "#/$defs/documentationUpdate"
    },
    "dispatch": {
      "$ref": "#/$defs/dispatch"
    }
  },
  "$defs": {
    "nonEmpty": {
      "type": "string",
      "minLength": 1
    },
    "packageIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmpty"
        },
        "version": {
          "$ref": "#/$defs/nonEmpty"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "pullRequest",
        "revision",
        "release",
        "package",
        "followUp"
      ],
      "properties": {
        "repository": {
          "$ref": "#/$defs/nonEmpty"
        },
        "pullRequest": {
          "$ref": "#/$defs/nonEmpty"
        },
        "revision": {
          "$ref": "#/$defs/nonEmpty"
        },
        "release": {
          "$ref": "#/$defs/nonEmpty"
        },
        "package": {
          "$ref": "#/$defs/packageIdentity"
        },
        "followUp": {
          "$ref": "#/$defs/nonEmpty"
        }
      }
    },
    "affectedDocumentation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uids",
        "areas",
        "followUp"
      ],
      "properties": {
        "uids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmpty"
          }
        },
        "areas": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "root",
              "dataminer",
              "develop",
              "solutions",
              "tutorials",
              "connectors",
              "release-notes",
              "contributing",
              "unknown"
            ]
          }
        },
        "followUp": {
          "$ref": "#/$defs/nonEmpty"
        }
      }
    },
    "sourceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release",
        "package",
        "followUp"
      ],
      "properties": {
        "release": {
          "$ref": "#/$defs/nonEmpty"
        },
        "package": {
          "$ref": "#/$defs/packageIdentity"
        },
        "followUp": {
          "$ref": "#/$defs/nonEmpty"
        }
      }
    },
    "generatedReferences": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "present",
        "contentTypes",
        "sourceIdentity",
        "followUp"
      ],
      "properties": {
        "present": {
          "type": "boolean"
        },
        "contentTypes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "api",
              "schema",
              "example"
            ]
          }
        },
        "sourceIdentity": {
          "$ref": "#/$defs/sourceIdentity"
        },
        "followUp": {
          "$ref": "#/$defs/nonEmpty"
        }
      }
    },
    "acknowledgement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "actor",
        "recordedAt",
        "evidence",
        "followUp"
      ],
      "properties": {
        "status": {
          "enum": [
            "acknowledged",
            "not_acknowledged",
            "unknown"
          ]
        },
        "actor": {
          "$ref": "#/$defs/nonEmpty"
        },
        "recordedAt": {
          "type": "string",
          "pattern": "^(\\d{4}-\\d{2}-\\d{2}|unknown)$"
        },
        "evidence": {
          "$ref": "#/$defs/nonEmpty"
        },
        "followUp": {
          "$ref": "#/$defs/nonEmpty"
        }
      }
    },
    "documentationUpdate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "uids",
        "areas",
        "evidence",
        "followUp"
      ],
      "properties": {
        "status": {
          "enum": [
            "updated",
            "not_applicable",
            "required",
            "unknown"
          ]
        },
        "uids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmpty"
          }
        },
        "areas": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "root",
              "dataminer",
              "develop",
              "solutions",
              "tutorials",
              "connectors",
              "release-notes",
              "contributing",
              "unknown"
            ]
          }
        },
        "evidence": {
          "$ref": "#/$defs/nonEmpty"
        },
        "followUp": {
          "$ref": "#/$defs/nonEmpty"
        }
      }
    },
    "dispatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "permission",
        "followUp"
      ],
      "properties": {
        "status": {
          "enum": [
            "not_requested",
            "requested",
            "completed",
            "unknown"
          ]
        },
        "permission": {
          "enum": [
            "available",
            "unavailable",
            "unknown"
          ]
        },
        "followUp": {
          "$ref": "#/$defs/nonEmpty"
        }
      }
    }
  }
}
